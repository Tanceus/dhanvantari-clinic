# Copy this file to .env and fill values. NEVER commit .env.
# VITE_-prefixed vars ship to the browser — put only non-secret values there.
# All secrets are backend-only.

# Frontend (Vite — must be prefixed VITE_ to be exposed to the client)
VITE_API_BASE_URL=            # FastAPI base URL, e.g. http://localhost:8000 (Cycle 2/5)
VITE_ACTIVE_CLINIC_ID=        # optional override for ACTIVE_CLINIC_ID (multi-tenant)

# --- The following are BACKEND-ONLY. Never prefix with VITE_. Never expose to the client. ---

# Supabase (Cycle 1)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=    # server-side only — full DB access, bypasses RLS
SUPABASE_ANON_KEY=            # client-safe key if ever needed

# AI message generation (Cycle 4)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Gmail API (Cycle 6)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
