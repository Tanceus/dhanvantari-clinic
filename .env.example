# Copy this file to .env and fill values. NEVER commit .env.
# VITE_-prefixed vars ship to the browser — put only non-secret values there.
# All secrets are backend-only.

# Frontend (Vite — must be prefixed VITE_ to be exposed to the client)
VITE_API_BASE_URL=https://dhanvantari-backend-production-cc90.up.railway.app
# FastAPI base URL. Local: http://localhost:8000

VITE_CLINIC_ID=55ad4fc1-a5ad-4ddb-bcfa-d76ab1df7375
# UUID sent as X-Clinic-Id on every clinic-scoped API request.
# This is the live clinic row in Supabase.

VITE_ACTIVE_CLINIC_ID=dhanvantari-001
# Local branding/config key from Cycle 0 (src/config/clinics.ts).
# VITE_CLINIC_ID and VITE_ACTIVE_CLINIC_ID are the same "which clinic am I"
# concept, but two separate env vars until Cycle 8 multi-clinic login.
# Keep them in sync manually: branding key dhanvantari-001 ↔ UUID above.

# Staff login (Supabase Auth). The anon key is designed for the browser —
# it is not a secret. Never put SUPABASE_SERVICE_ROLE_KEY here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- The following are BACKEND-ONLY. Never prefix with VITE_. Never expose to the client. ---

# Supabase (Cycle 1)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=    # server-side only — full DB access, bypasses RLS
SUPABASE_ANON_KEY=            # same value as VITE_SUPABASE_ANON_KEY; used by FastAPI

# AI message generation (Cycle 4)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Gmail API (Cycle 6)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
